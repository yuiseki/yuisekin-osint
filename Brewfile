# OSINT tools for macOS
# Usage: brew bundle --file=Brewfile

# Network reconnaissance
brew "nmap"           # Port scanning, service detection
brew "mtr"            # Traceroute + ping combined
brew "subfinder"      # Subdomain enumeration

# DNS / WHOIS (macOS built-in but listed for completeness)
# whois, dig, nslookup — already in macOS

# GeoIP
brew "geoip2fast"     # Fast GeoIP lookup (replaces legacy geoiplookup)

# HTTP
brew "httpie"         # Human-friendly HTTP client

# Utilities
brew "jq"             # JSON processor
